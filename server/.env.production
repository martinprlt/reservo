# ============================================
# SLOTIFY - Variables de Entorno
# ============================================

# Base de datos (Railway te da esto)
DATABASE_URL=postgresql://user:password@host:5432/slotify

# Autenticación
JWT_SECRET=change-this-to-a-long-random-string-at-least-64-chars
JWT_EXPIRES_IN=8h

# MercadoPago (OPCIONAL - cada admin pone sus credenciales)
# Estas son para PRUEBAS o si querés gestionar los pagos vos
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_BACK_URL=https://slotify.app/confirmacion

# Twilio WhatsApp (necesario para notificaciones)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# App
NODE_ENV=production
PORT=4000
FRONTEND_URL=https://slotify.app
