# ============================================
# SLOTIFY - Variables de Entorno
# ============================================

# Base de datos (Railway te da esto)
DATABASE_URL=postgresql://user:password@host:5432/slotify

# Autenticación
JWT_SECRET=change-this-to-a-long-random-string-at-least-64-chars
JWT_EXPIRES_IN=8h

# MercadoPago (OPCIONAL - cada admin pone sus credenciales)
# Estas son para PRUEBAS o si querés gestionar los pagos vos
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_BACK_URL=https://slotifyapp.site/confirmacion

# Twilio WhatsApp (necesario para notificaciones)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Push notifications (VAPID keys — generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=BJ13Cxo_Slis4-d1ueoc85i2oQH1Poj1B15IzS5iHbcAcsqFOfvNgvPSCnP06t02xSAPazIoYPOTX4qQM6GrcYs
VAPID_PRIVATE_KEY=FoTAVRUJAI8Q2EeD3QqBM5OdYcBztLBl_mjbFCib1mw

