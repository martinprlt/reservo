generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EstadoTurno {
  RESERVADO
  SENIADO
  CONFIRMADO
  COMPLETADO
  CANCELADO
}

enum EstadoPago {
  PENDIENTE
  APROBADO
  RECHAZADO
  REEMBOLSADO
}

enum Plan {
  FREE
  BASICO
  PRO
}

model Tenant {
  id        String   @id @default(cuid())
  nombre    String
  slug      String   @unique
  plan      Plan     @default(FREE)
  activo    Boolean  @default(true)
  config    Json     @default("{}")
  creadoEn  DateTime @default(now())
  updatedAt DateTime @updatedAt

  admins     Admin[]
  clientes   Cliente[]
  servicios  Servicio[]
  turnos     Turno[]
  incentivos Incentivo[]
  notificaciones Notificacion[]
  pushSubscriptions PushSubscription[]
}

enum Role {
  ADMIN
  SUPER_ADMIN
}

model Admin {
  id           String   @id @default(cuid())
  tenantId     String?
  email        String   @unique
  passwordHash String
  nombre       String
  role         Role     @default(ADMIN)
  creadoEn     DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model Cliente {
  id        String   @id @default(cuid())
  tenantId  String
  nombre    String
  apellido  String
  telefono  String
  puntos    Int      @default(0)
  notas     String?
  creadoEn  DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  turnos Turno[]

  @@unique([tenantId, telefono])
  @@index([tenantId])
}

model Servicio {
  id              String   @id @default(cuid())
  tenantId        String
  nombre          String
  descripcion     String?  // Optional description shown in booking
  rubro           String   @default("general")
  duracionMinutos Int
  precio          Float
  montoSenia      Float
  puntosOtorgados Int      @default(1)
  activo          Boolean  @default(true)
  variantes       Json?
  foto            String?  // URL of the service photo
  esDomicilio     Boolean  @default(false)
  tiempoDesplazamiento Int? // minutes to travel to client location
  creadoEn        DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  turnos Turno[]

  @@index([tenantId])
}

model Turno {
  id            String      @id @default(cuid())
  tenantId      String
  clienteId     String
  servicioId    String
  fechaHora     DateTime
  duracion      Int
  estado        EstadoTurno @default(RESERVADO)
  precioTotal   Float
  montoSenia    Float
  expiraEn      DateTime?
  notas         String?
  fotoUrl       String?     // Reference photo uploaded by client during booking
  mpPrefId      String?
   fotoPublicId  String?     // Cloudinary public ID for cleanup
   aceptaNotificaciones Boolean @default(false)
   creadoEn      DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  cliente  Cliente  @relation(fields: [clienteId], references: [id])
  servicio Servicio @relation(fields: [servicioId], references: [id])
  pagos    Pago[]

  @@index([tenantId])
  @@index([tenantId, fechaHora])
}

model Pago {
  id          String      @id @default(cuid())
  turnoId     String
  mpPaymentId String?     @unique
  monto       Float
  estado      EstadoPago  @default(PENDIENTE)
  fechaPago   DateTime?
  metodoPago  String?     // 'MP' for MercadoPago, 'MANUAL' for cash/WhatsApp
  creadoEn    DateTime    @default(now())

  turno Turno @relation(fields: [turnoId], references: [id])
}

model Incentivo {
  id               String  @id @default(cuid())
  tenantId         String
  nombre           String
  puntosRequeridos Int
  tipoDescuento    String
  valor            Float
  activo           Boolean @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model Notificacion {
  id        String   @id @default(cuid())
  tenantId  String
  tipo      String   // NUEVO_TURNO, PAGO_RECIBIDO, TURNO_MANANA, etc.
  titulo    String
  mensaje   String
  leida     Boolean  @default(false)
  link      String?  // Link interno para navegar
  creadoEn  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, leida])
}

model PushSubscription {
  id           String   @id @default(cuid())
  tenantId     String
  endpoint     String
  p256dh       String
  auth         String
  activa       Boolean  @default(true)
  creadoEn     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, endpoint])
  @@index([tenantId])
}
